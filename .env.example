# Copie para .env (ignorado pelo git): cp .env.example .env
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway

# Portas publicadas no host (dentro do Docker o app usa 8080 e o banco 5432)
APP_HOST_PORT=8090
POSTGRES_HOST_PORT=5433
PSP_HOST_PORT=9091

LOG_LEVEL=info

# Só para rodar o app fora do Docker (make run)
DATABASE_URL=postgres://gateway:gateway@localhost:5433/gateway?sslmode=disable

# Só para rodar o app fora do Docker (make run); no compose estes valores já vêm definidos
PSP_BASE_URL=http://localhost:9091
PSP_ATTEMPT_TIMEOUT=1s
PLATFORM_FEE_BPS=290

# Receptor de webhooks de exemplo (só desenvolvimento)
SINK_SECRET=whsec_dev_secret
SINK_FAIL_FIRST=2
SINK_HOST_PORT=9101

# Portas de operação publicadas no host (/metrics). Só desenvolvimento.
METRICS_HOST_PORT=9102
WORKER_METRICS_HOST_PORT=9103
