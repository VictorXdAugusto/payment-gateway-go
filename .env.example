# Copie para .env (ignorado pelo git): cp .env.example .env
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway

# Portas publicadas no host (dentro do Docker o app usa 8080 e o banco 5432)
APP_HOST_PORT=8090
POSTGRES_HOST_PORT=5433

LOG_LEVEL=info

# Só para rodar o app fora do Docker (make run)
DATABASE_URL=postgres://gateway:gateway@localhost:5433/gateway?sslmode=disable
